API_KEY=dev-secret-api-key

DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
TEST_DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments_test
PYTEST_WORKERS=4

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

LOG_LEVEL=INFO

PROCESSING_MAX_ATTEMPTS=3
PROCESSING_RETRY_BASE_DELAY_SECONDS=2
CONSUMER_PREFETCH_COUNT=10
QUEUE_DELIVERY_LIMIT=3
QUEUE_MAX_LENGTH=100000

OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_BATCH_SIZE=100

WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_TRUSTED_HOSTS=["localhost"]

GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9

WEBHOOK_MOCK_FAILURE_RATE=0.3

ORDER_GENERATOR_API_URL=http://localhost:8000
ORDER_GENERATOR_WEBHOOK_URL=http://localhost:8080/webhooks
ORDER_GENERATOR_RATE_PER_SECOND=2
ORDER_GENERATOR_TOTAL=0
ORDER_GENERATOR_DUPLICATE_RATE=0.1
